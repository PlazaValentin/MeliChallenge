# URL del backend contra la que corre el frontend.
#
# Se versiona a proposito: no guarda secretos, y sin este archivo la aplicacion
# no arranca (la variable no tiene default en el codigo). Dejarlo fuera del
# repositorio obligaria a cada quien que clone a adivinar como se llama la
# variable antes de poder levantar nada.
#
# Tiene que coincidir con el server.port del backend, y el origen desde el que
# se sirve este frontend tiene que coincidir con app.cors.allowed-origin.
VITE_API_BASE_URL=http://localhost:8080
