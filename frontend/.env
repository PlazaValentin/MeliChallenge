# Override de la URL del backend.
#
# Va comentada a proposito. Por defecto el frontend deriva la URL del host desde
# el que se abrio la pagina, reemplazando el puerto 3000 por el 8080: eso
# funciona tanto en desarrollo local como detras del proxy del entorno de
# evaluacion, donde el host se genera por sesion y no se puede escribir de
# antemano.
#
# Solo hace falta declararla para apuntar a un backend que no este en el mismo
# host que el frontend. En ese caso, el origen desde el que se sirve este
# frontend tiene que estar contemplado en app.cors.allowed-origin-patterns.
#
# El archivo se versiona igual: documenta que la variable existe y como se usa.
# VITE_API_BASE_URL=http://localhost:8080
