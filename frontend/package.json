{
  "name": "challenge-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "cd ../backend && gradle build -x test",
    "pretest": "bash ../setup.sh",
    "prestart": "bash ../setup.sh",
    "client": "vite",
    "server": "cd ../backend && gradle bootRun",
    "start": "npx concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "test-frontend": "echo 'Replace with your frontend test command'",
    "test-backend": "cd ../backend && gradle test",
    "test": "npm run test-frontend && npm run test-backend",
    "posttest": "mv ../backend/build/test-results/test/TEST-com.hackerrank.corebanking.controller.AccountControllerTest.xml ../backend.xml 2>/dev/null || true"
  },
  "dependencies": {
    "concurrently": "^8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}