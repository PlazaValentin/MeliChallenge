# gradlew es un script de shell que se ejecuta dentro de un contenedor Linux.
# Sin esto, un checkout en Windows lo deja con CRLF y el build de Docker falla
# con "bad interpreter: /bin/sh^M".
gradlew text eol=lf
*.sh text eol=lf

# El .bat es el unico que necesita CRLF, porque lo corre cmd.exe.
gradlew.bat text eol=crlf

gradle-wrapper.jar binary
